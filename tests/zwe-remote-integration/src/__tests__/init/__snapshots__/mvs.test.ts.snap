SH cd '/test/dir' &&
cd components/zss &&
ZWE_TMP_MVS2='TEST.DATASET.PFX.SZWELOAD' &&
cp -X LOADLIB/ZWESIS01
"//'$ZWE_TMP_MVS2(ZWESIS01)'" &&
cp -X LOADLIB/ZWESAUX
"//'$ZWE_TMP_MVS2(ZWESAUX)'" &&
cp -X LOADLIB/ZWESISDL
"//'$ZWE_TMP_MVS2(ZWESISDL)'" &&
cd ../launcher/bin &&
cp -X zowe_launcher
"//'$ZWE_TMP_MVS2(ZWELNCH)'"

exports[`zwe-install (SHORT) zwe install --help 1`] = `
"zwe install
------------------
Synopsis
    zwe install [parameter [parameter]...]
------------------
Description
    After you extract Zowe convenience build, you can run this command to install
    MVS data sets.
    If you are using SMPE build, you can skip this command since MVS data sets are
    already prepared during SMPE install.
    These Zowe YAML configurations showing with sample values are used:
    \`\`\`
    zowe:
      setup:
        jcl:
          header: 123456
        dataset:
          prefix: IBMUSER.ZWE
    \`\`\`
    Expected outputs:
    - Will create these data sets under \`zowe.setup.dataset.prefix\` definition:
      * \`SZWEAUTH\` contains few Zowe load modules (++PROGRAM).
      * \`SZWESAMP\` contains several sample configurations.
      * \`SZWEEXEC\` contains few utilities used by Zowe.
      * \`SZWELOAD\` contains config manager for REXX.
------------------
Global parameters
    --help|-h  (optional)
        Display this help.
    --debug|--verbose|-v  (optional)
        Enable verbose mode.
    --trace|-vv  (optional)
        Enable trace level debug mode.
    --silent|-s  (optional)
        Do not display messages to standard output.
    --log-dir|--log|-l string (optional)
        Write logs to this directory.
    --config|-c string (optional)
        Path to Zowe configuration zowe.yaml file.
    --configmgr  (optional)
        Deprecated. This behavior is always enabled.
------------------
Parameters for command "install"
    --allow-overwrite|--allow-overwritten  (optional)
        Allow overwritten existing MVS data set.
    --dry-run  (optional)
        Prints out existing JCL templates but does not generate resolved JCL.
------------------
Example(s)
    zwe install -v -c /path/to/zowe.yaml"
`;

exports[`zwe-install (SHORT) zwe install invalid config 1`] = `
"Error: Could not load config for FILE(/not/real/config.yml):FILE(/test/dir/files/defaults.yaml), status=7
ZWEL0318E - failed to read '/not/real/config.yml' - EDC5129I No such file or directory. (errno2=0x0594003D)"
`;

exports[`zwe-install (SHORT) zwe install invalid dataset name 1`] = `
"Error: Validation of FILE(/test/dir/zowe.test.yaml):FILE(/test/dir/files/defaults.yaml) against schema /test/dir/schemas/zowe-yaml-schema.json:/test/dir/schemas/server-common.json found invalid JSON Schema data
Validity Exceptions(s) with object at
  Validity Exceptions(s) with object at /zowe
    Validity Exceptions(s) with object at /zowe/setup
      Validity Exceptions(s) with object at /zowe/setup/dataset
        Validity Exceptions(s) with string at /zowe/setup/dataset/prefix
          string pattern match fail s='INVALID.DSN.LENGTH123123', pat='^([A-Z\\$\\#\\@]){1}([A-Z0-9\\$\\#\\@\\-]){0,7}(\\.([A-Z\\$\\#\\@]){1}([A-Z0-9\\$\\#\\@\\-]){0,7}){0,11}$', at /zowe/setup/dataset/prefix"
`;

exports[`zwe-install (SHORT) zwe install invalid dataset name 2`] = `
"Temporary directory '/tmp/.zweenv-0000' created.
Zowe will remove it on success, but if zwe exits with a non-zero code manual cleanup would be needed.
-------------------------------------------------------------------------------
>> Install Zowe MVS data sets
ERROR: Error ZWEL0157E: Zowe dataset prefix (zowe.setup.dataset.prefix) is not defined in Zowe YAML configuration file."
`;

exports[`zwe-install (SHORT) zwe install invalid parameter 1`] = `"Error ZWEL0102E: Invalid parameter --ds-prefix"`;

exports[`zwe-install (SHORT) zwe install invalid runtime directory 1`] = `
"Temporary directory '/tmp/.zweenv-0000' created.
Zowe will remove it on success, but if zwe exits with a non-zero code manual cleanup would be needed.
-------------------------------------------------------------------------------
